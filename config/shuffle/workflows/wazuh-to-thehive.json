{
  "id": "sin-wazuh-to-thehive",
  "name": "Wazuh Alert to TheHive Case Creation",
  "description": "Workflow que recibe alertas de Wazuh via webhook, enriquece con Cortex y MISP, y crea caso en TheHive",
  "trigger": {
    "type": "webhook",
    "name": "Wazuh Webhook",
    "parameters": {
      "path": "/api/v1/hooks/wazuh",
      "method": "POST"
    }
  },
  "actions": [
    {
      "id": "action-1",
      "name": "Parse Wazuh Alert",
      "app": "Wazuh",
      "action": "parse_alert",
      "parameters": {
        "input": "${trigger.data}"
      }
    },
    {
      "id": "action-2",
      "name": "Extract IP and IoCs",
      "app": "Utilities",
      "action": "regex",
      "parameters": {
        "input": "${action-1.result}",
        "regex": "srcip=([0-9.]+)",
        "output_field": "src_ip"
      }
    },
    {
      "id": "action-3",
      "name": "Enrich with AbuseIPDB",
      "app": "Cortex",
      "action": "run_analyzer",
      "parameters": {
        "analyzer": "AbuseIPDB_1_0",
        "observable_type": "ip",
        "observable_value": "${action-2.src_ip}"
      }
    },
    {
      "id": "action-4",
      "name": "Enrich with VirusTotal",
      "app": "Cortex",
      "action": "run_analyzer",
      "parameters": {
        "analyzer": "VirusTotal_GetReport_3_0",
        "observable_type": "ip",
        "observable_value": "${action-2.src_ip}"
      }
    },
    {
      "id": "action-5",
      "name": "MISP IOC Lookup",
      "app": "MISP",
      "action": "search_ioc",
      "parameters": {
        "value": "${action-2.src_ip}"
      }
    },
    {
      "id": "action-6",
      "name": "Create TheHive Case",
      "app": "TheHive",
      "action": "create_case",
      "parameters": {
        "title": "TaxFisco Alert: ${action-1.rule_description}",
        "description": "Automated case from Wazuh alert. ATT&CK: ${action-1.mitre_id}",
        "severity": "${action-1.alert_level}",
        "tlp": "AMBER",
        "tags": ["sin", "honeypot", "${action-1.mitre_tactic}"]
      }
    },
    {
      "id": "action-7",
      "name": "Add Observable to Case",
      "app": "TheHive",
      "action": "add_observable",
      "parameters": {
        "case_id": "${action-6.case_id}",
        "observable_type": "ip",
        "observable_value": "${action-2.src_ip}",
        "tlp": "AMBER",
        "tags": ["attacker-source"]
      }
    },
    {
      "id": "action-8",
      "name": "Notify SOC Team",
      "app": "Email",
      "action": "send_email",
      "parameters": {
        "to": ["soc@sin.local"],
        "subject": "[TaxFisco] New Incident: ${action-1.rule_description}",
        "body": "Case ID: ${action-6.case_id}\nSeverity: ${action-1.alert_level}\nATT&CK: ${action-1.mitre_id}\nIP: ${action-2.src_ip}"
      }
    }
  ]
}
