<!--
  Wazuh Rules - SIN Research Lab (Prototipo II)
  Reglas de deteccion mapeadas a MITRE ATT&CK.

  La regla nativa 86601 procesa las alertas de Suricata que llegan por
  eve.json. Las reglas de este archivo anaden contexto ATT&CK segun la
  firma que disparo.
-->

<group name="sin,">

  <!-- ======================================================================
       Detecciones derivadas de Suricata (NIDS)
       ====================================================================== -->

  <!-- LFI / lectura de /etc/passwd -->
  <rule id="100200" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">2024030</field>
    <description>Suricata: intento de lectura de /etc/passwd desde $(src_ip) - ATT&CK T1083</description>
    <mitre>
      <id>T1083</id>
    </mitre>
  </rule>

  <!-- Path traversal -->
  <rule id="100201" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">2024031</field>
    <description>Suricata: path traversal desde $(src_ip) - ATT&CK T1083</description>
    <mitre>
      <id>T1083</id>
    </mitre>
  </rule>

  <!-- SQLMap -->
  <rule id="100202" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">2024002</field>
    <description>Suricata: escaneo con SQLMap desde $(src_ip) - ATT&CK T1595</description>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

  <!-- Acceso a endpoint administrativo del decoy -->
  <rule id="100203" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">2024050</field>
    <description>Suricata: acceso a endpoint administrativo del decoy desde $(src_ip) - ATT&CK T1078</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- Exportacion masiva de datos -->
  <rule id="100204" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">2024051</field>
    <description>Suricata: exportacion masiva de datos del decoy desde $(src_ip) - ATT&CK T1530</description>
    <mitre>
      <id>T1530</id>
    </mitre>
  </rule>

  <!-- Command injection -->
  <rule id="100205" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">2024040</field>
    <description>Suricata: command injection desde $(src_ip) - ATT&CK T1059</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <!-- Regla generica: alerta de Suricata de alta severidad -->
  <rule id="100260" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.severity">1</field>
    <description>Suricata: alerta de alta severidad - $(alert.signature)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- ======================================================================
       Interaccion con el decoy (marcador en logs de aplicacion)
       ====================================================================== -->

  <rule id="100280" level="5">
    <match>X-SIN-Env: decoy</match>
    <description>Interaccion con servicio decoy registrada</description>
  </rule>

</group>
