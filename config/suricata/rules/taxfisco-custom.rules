# Suricata custom rules - TaxFisco Research Lab
# Reglas personalizadas para honeypots fiscales

# ============================================================================
# Reconocimiento
# ============================================================================
alert http any any -> $HOME_NET any (msg:"TAX-FISCO Nmap scan detected"; flow:to_server,established; content:"Nmap"; http_user_agent; classtype:attempted-recon; sid:2024001; rev:1; metadata:mitre_technique_id T1595;)
alert http any any -> $HOME_NET any (msg:"TAX-FISCO SQLMap scan detected"; flow:to_server,established; content:"sqlmap"; http_user_agent; classtype:web-application-attack; sid:2024002; rev:1; metadata:mitre_technique_id T1595.002;)
alert http any any -> $HOME_NET any (msg:"TAX-FISCO Nikto scan detected"; flow:to_server,established; content:"Nikto"; http_user_agent; classtype:web-application-attack; sid:2024003; rev:1; metadata:mitre_technique_id T1595.002;)
alert http any any -> $HOME_NET any (msg:"TAX-FISCO Nuclei scan detected"; flow:to_server,established; content:"nuclei"; http_user_agent; classtype:web-application-attack; sid:2024004; rev:1; metadata:mitre_technique_id T1595.002;)

# ============================================================================
# SQL Injection
# ============================================================================
alert http any any -> $HOME_NET any (msg:"TAX-FISCO SQL Injection - UNION SELECT"; flow:to_server,established; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:2024010; rev:1; metadata:mitre_technique_id T1190;)
alert http any any -> $HOME_NET any (msg:"TAX-FISCO SQL Injection - OR 1=1"; flow:to_server,established; content:"or"; nocase; content:"1=1"; nocase; distance:0; classtype:web-application-attack; sid:2024011; rev:1; metadata:mitre_technique_id T1190;)
alert http any any -> $HOME_NET any (msg:"TAX-FISCO SQL Injection - sleep()"; flow:to_server,established; content:"sleep"; nocase; classtype:web-application-attack; sid:2024012; rev:1; metadata:mitre_technique_id T1190;)
alert http any any -> $HOME_NET any (msg:"TAX-FISCO SQL Injection - information_schema"; flow:to_server,established; content:"information_schema"; nocase; classtype:web-application-attack; sid:2024013; rev:1; metadata:mitre_technique_id T1190;)

# ============================================================================
# XSS
# ============================================================================
alert http any any -> $HOME_NET any (msg:"TAX-FISCO XSS - script tag"; flow:to_server,established; content:"<script"; nocase; classtype:web-application-attack; sid:2024020; rev:1; metadata:mitre_technique_id T1059.007;)
alert http any any -> $HOME_NET any (msg:"TAX-FISCO XSS - javascript: URI"; flow:to_server,established; content:"javascript:"; nocase; classtype:web-application-attack; sid:2024021; rev:1; metadata:mitre_technique_id T1059.007;)
alert http any any -> $HOME_NET any (msg:"TAX-FISCO XSS - onerror handler"; flow:to_server,established; content:"onerror"; nocase; classtype:web-application-attack; sid:2024022; rev:1; metadata:mitre_technique_id T1059.007;)

# ============================================================================
# Path Traversal / LFI
# ============================================================================
alert http any any -> $HOME_NET any (msg:"TAX-FISCO LFI - /etc/passwd"; flow:to_server,established; content:"/etc/passwd"; nocase; classtype:web-application-attack; sid:2024030; rev:1; metadata:mitre_technique_id T1083;)
alert http any any -> $HOME_NET any (msg:"TAX-FISCO LFI - ../../ traversal"; flow:to_server,established; content:"../../"; classtype:web-application-attack; sid:2024031; rev:1; metadata:mitre_technique_id T1083;)

# ============================================================================
# Command Injection
# ============================================================================
alert http any any -> $HOME_NET any (msg:"TAX-FISCO Command Injection - shell metachars"; flow:to_server,established; content:"|3B|"; classtype:web-application-attack; sid:2024040; rev:1; metadata:mitre_technique_id T1059;)
alert http any any -> $HOME_NET any (msg:"TAX-FISCO Command Injection - pipe to bash"; flow:to_server,established; content:"|7C|"; content:"/bin/bash"; distance:0; classtype:web-application-attack; sid:2024041; rev:1; metadata:mitre_technique_id T1059;)

# ============================================================================
# Decoy API Triggers
# ============================================================================
alert http any any -> $HOME_NET any (msg:"TAX-FISCO Decoy Admin endpoint accessed"; flow:to_server,established; content:"/api/v1/admin/"; classtype:attempted-admin; sid:2024050; rev:1; metadata:mitre_technique_id T1078;)
alert http any any -> $HOME_NET any (msg:"TAX-FISCO Decoy data-export endpoint accessed"; flow:to_server,established; content:"/api/v1/admin/export-all"; classtype:attempted-recon; sid:2024051; rev:1; metadata:mitre_technique_id T1530;)

# ============================================================================
# Brute force (multi-event)
# ============================================================================
alert http any any -> $HOME_NET any (msg:"TAX-FISCO Multiple failed logins (possible brute force)"; flow:to_server,established; content:"/api/v1/auth/login"; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-user; sid:2024060; rev:1; metadata:mitre_technique_id T1110.001;)

# ============================================================================
# Malware patterns (basic)
# ============================================================================
alert http any any -> $HOME_NET any (msg:"TAX-FISCO EICAR test file download"; flow:to_server,established; content:"X5O!P%@AP[4\\PZX54(P^)7CC)7}$EICAR"; classtype:misc-activity; sid:2024070; rev:1; metadata:mitre_technique_id T1105;)
